# Sprint 13 - Section 29: Environment Configuration
# Copy this file to `.env` in the project root and fill in real values.
# NEVER commit the real .env file - it is already listed in .gitignore.

# --- Database -----------------------------------------------------------
# Postgres connection string used by app/core/config.py (settings.database_url)
DATABASE_URL=postgresql://expert_decision_user:CHANGE_ME@localhost:5432/expert_decision_replay

# --- Auth / JWT -----------------------------------------------------------
# Used by app/utils/security.py. Generate a long random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Application ------------------------------------------------------
APP_NAME="Expert Decision Replay Platform"
ENVIRONMENT=development

# --- CORS (Section 28) -------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
ALLOWED_ORIGINS=http://localhost:3000

# --- File / document storage (if document upload is implemented) -------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
