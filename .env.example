# Application Configuration
APP_NAME=Expert Decision Replay Platform

# Database Connection (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/expert_decision_replay

# JWT Authentication Security Settings
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
