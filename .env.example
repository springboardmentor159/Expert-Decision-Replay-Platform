# Expert Decision Replay Platform - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your local/production credentials.

# Application Information
APP_NAME="Expert Decision Replay Platform"

# Database Connection URL (PostgreSQL)
# Format: postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/expert_decision_replay

# JWT Authentication & Security Configuration
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
