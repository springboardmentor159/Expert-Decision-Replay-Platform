# ==============================================================================
# Expert Decision Replay Platform - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your local settings.
# ==============================================================================

# Application Name
APP_NAME=Expert Decision Replay Platform

# Database Connection (PostgreSQL with psycopg2 driver)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/expert_decision_replay

# JWT Authentication Secret Key (Generate a secure random 32+ char string for production)
SECRET_KEY=replace_with_a_secure_random_secret_key_for_production_use

# JWT Signing Algorithm (e.g. HS256)
ALGORITHM=HS256

# Access Token Expiry in Minutes (Default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
